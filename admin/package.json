{
  "name": "admin",
  "version": "0.0.0",
  "scripts": {
    "build": "npm-run-all config tailwind esbuild",
    "dev": "dotenv -- sh -c 'npm-run-all -s config tailwind && npm-run-all -l -p serve tailwind-watch esbuild-watch tsc-watch'",
    "build-docker": "npm-run-all tailwind esbuild",
    "serve-docker": "npm run config && ./bin/serve-public",
    "config": "./bin/prepare-config-json > ./public/config.json",
    "serve": "http-server -c-1 -p 8083 -P http://localhost:8083?",
    "tailwind": "tailwindcss -i ./src/index.css -o ./public/index.css",
    "tailwind-watch": "tailwindcss -i ./src/index.css -o ./public/index.css --watch",
    "esbuild": "node ./build.mjs",
    "esbuild-watch": "ADMIN_BUILD_IS_DEV=1 node ./build.mjs",
    "tsc": "tsc --noEmit",
    "tsc-watch": "tsc --noEmit --watch --preserveWatchOutput",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-query": "^1.4.2",
    "@connectrpc/connect-web": "^1.7.0",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-oauth/google": "^0.13.5",
    "@segment/analytics-next": "^1.84.1",
    "@sentry/react": "^8.55.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv-cli": "^7.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "express": "^4.22.2",
    "highlight.js": "^11.12.0",
    "http-server": "^14.1.1",
    "lucide-react": "^0.577.0",
    "moment": "^2.30.1",
    "morgan": "^1.11.0",
    "next-themes": "^0.4.6",
    "npm-run-all": "^4.1.5",
    "posthog-js": "^1.418.10",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.86.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "xml-formatter": "^3.7.0",
    "zod": "^3.25.76"
  }
}
